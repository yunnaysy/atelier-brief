# Firebase web config (public client identifiers, not server secrets).
# Create a Spark (free) project, register a Web app, and paste the values here.
# Never enable Blaze billing. Never commit a filled .env or App Check debug token.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key used by Firebase App Check (public site key only).
VITE_FIREBASE_RECAPTCHA_V3_SITE_KEY=

# Set to "true" only on your own machine so App Check can mint a local debug token.
# Do not set this in a production Hosting deploy. Never paste a debug token string here
# if this file might be committed — keep tokens in .env.local (gitignored).
VITE_FIREBASE_APPCHECK_DEBUG=false

# Optional override. Official default for Firebase JS SDK v13+ is gemini-3.5-flash-lite (free-tier text).
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite
