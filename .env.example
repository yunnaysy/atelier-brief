# Firebase web config (public client identifiers, not server secrets).
# Create a Spark (free) project, register a Web app, and paste the values here.
# Never enable Blaze billing. Never commit a filled .env or App Check debug token.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Official recommendation for new App Check integrations: reCAPTCHA Enterprise
# (10,000 assessments/month at no cost). reCAPTCHA v3 is still accepted —
# set VITE_FIREBASE_APPCHECK_PROVIDER=v3 if you only have a v3 site key.
# Use the public site key only (never a secret key).
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
# Legacy alias, still read if VITE_FIREBASE_RECAPTCHA_SITE_KEY is empty:
# VITE_FIREBASE_RECAPTCHA_V3_SITE_KEY=

# Set to "true" only in a local dev session (.env.local, gitignored).
# Production builds ignore this flag even if it is present, so a debug token
# cannot ship in a Spark Hosting deploy. Never paste a debug token string here.
VITE_FIREBASE_APPCHECK_DEBUG=false

# Official Gemini Developer API free-tier text model (billing not required).
# Do not switch to billed image models.
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite
